# Predeterminado si se omite; cambiar requiere reconstruir Next.js.
NEXT_PUBLIC_USE_MOCKS=true

# Solo servidor. Nunca usar NEXT_PUBLIC_ para tokens o client secrets.
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
OIDC_ISSUER=http://localhost:8080/realms/crm-rah-dev
OIDC_CLIENT_ID=crm-rah-app
# Excepción explícita: HTTP solo para issuer y aplicación en loopback.
OIDC_ALLOW_INSECURE_LOCALHOST=true
# Cliente público: sin secreto. El access token debe incluir aud crm-rah-api.
